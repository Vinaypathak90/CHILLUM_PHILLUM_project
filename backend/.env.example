# Environment Variables Template - Backend

# Copy this file to `.env` and fill in your actual values
# NEVER commit the actual .env file to Git!

# ============================================
# DATABASE
# ============================================

# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/chillum_phillum

# MongoDB Atlas (Cloud) - Get this from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster0.abc123.mongodb.net/chillum_phillum

# ============================================
# SERVER
# ============================================

# Port to run backend server on
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# ============================================
# AUTHENTICATION
# ============================================

# JWT Secret for signing tokens - Use a strong random string!
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_change_this_in_production_minimum_32_characters

# ============================================
# FILE UPLOADS
# ============================================

# Directory to store uploaded images
UPLOAD_DIR=./uploads

# Max file size in MB
MAX_FILE_SIZE=10

# ============================================
# CORS
# ============================================

# Frontend domain (for CORS allowlist)
CORS_ORIGIN=http://localhost:5173

# In production, change to: https://your-frontend-domain.com

# ============================================
# OPTIONAL: EMAIL (for contact form)
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ============================================
# OPTIONAL: GOOGLE MAPS
# ============================================

# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# LOGGING
# ============================================

# Log level (debug, info, warn, error)
LOG_LEVEL=debug
